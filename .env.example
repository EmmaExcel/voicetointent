# copy to .env and fill in your values

# ollama | lmstudio | openai | gemini | anthropic
LLM_PROVIDER=ollama

# LM Studio
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b
LMSTUDIO_API_KEY=lm-studio

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen:4b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Whisper — tiny, tiny.en, base, base.en, small, medium, large-v3
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
# int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# Mic
MIC_SILENCE_THRESHOLD_SECONDS=1.5
MIC_SILENCE_RMS_THRESHOLD=0.02
MIC_SAMPLE_RATE=16000

# override beneficiaries file path (default: data/beneficiaries.json)
# BENEFICIARIES_FILE=data/beneficiaries.json

# API server
API_HOST=0.0.0.0
API_PORT=8000
